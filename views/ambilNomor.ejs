<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 p-8">
    <div class="max-w-2xl mx-auto bg-white p-6 rounded-xl shadow-sm">
        <h2 class="text-2xl font-bold mb-6 text-blue-900"><i class="fas fa-ticket-alt mr-2"></i>Ambil Nomor Surat (Draft)</h2>
        <form action="/api/ambil-nomor" method="POST" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Tanggal Surat</label>
                    <input type="date" name="tanggal_surat" required class="mt-1 block w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Kode Klasifikasi</label>
                    <div class="flex gap-2 mt-1">
                        <select name="kode_klasifikasi" required class="block w-full border border-gray-300 rounded-md py-2 px-3 focus:ring-blue-500 focus:border-blue-500 sm:text-sm">
                            <option value="">-- Pilih Kode Klasifikasi --</option>
                        <% klasifikasi.forEach(function(k) { %>
                            <option value="<%= k.kode_klasifikasi %>"><%= k.kode_klasifikasi %> - <%= k.keterangan %></option>
                        <% }); %>
                        </select>
                    </div>
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700">Peminta / Tujuan Surat</label>
                <input type="text" name="peminta" placeholder="Nama Staff / Unit Tujuan" required class="mt-1 block w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500">
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Perihal / Judul Draft</label>
                    <input type="text" name="perihal" required class="mt-1 block w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Tipe Berkas (JRA)</label>
                    <select name="tipe_berkas" required class="mt-1 block w-full border border-gray-300 rounded-md p-2 focus:ring-blue-500">
                        <option value="Surat Biasa">Surat Biasa</option>
                        <option value="Surat Undangan">Surat Undangan</option>
                        <option value="SK Kegiatan">SK Kegiatan (Aktif 1 Tahun)</option>
                        <option value="SK Jabatan">SK Jabatan (Aktif 4 Tahun)</option>
                        <option value="Surat Edaran">Surat Edaran</option>
                    </select>
                </div>
            </div>

            <div class="flex flex-col gap-3 mt-8 border-t pt-6">
                <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 px-4 rounded-md hover:bg-blue-700 transition">
                    Cetak & Ambil Nomor Sekarang
                </button>
                <a href="/" class="w-full text-center bg-gray-500 text-white font-bold py-3 px-4 rounded-md hover:bg-gray-600 transition">Kembali</a>
            </div>
        </form>
    </div>

    <script>
        // Tarik data klasifikasi dari API
        fetch('/api/klasifikasi')
            .then(res => res.json())
            .then(data => {
                const el = document.getElementById('kode_klasifikasi');
                data.forEach(item => el.innerHTML += `<option value="${item.kode_klasifikasi}">${item.kode_klasifikasi} - ${item.uraian}</option>`);
            });
    </script>
</body>
</html>