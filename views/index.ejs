<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 h-screen flex overflow-hidden">
    
    <!-- Sidebar -->
    <aside class="w-64 bg-blue-900 text-white flex flex-col">
        <div class="h-16 flex items-center justify-center font-bold text-2xl tracking-widest border-b border-blue-800">
            SIKD LPMPP
        </div>
        <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
            <p class="px-4 text-xs font-semibold text-blue-300 uppercase tracking-wider mb-2">Menu Utama</p>
            <a href="/" class="flex items-center gap-3 px-4 py-3 bg-blue-800 rounded-lg transition"><i class="fas fa-home"></i> Dashboard</a>
            <a href="/ambil-nomor" class="flex items-center gap-3 px-4 py-3 hover:bg-blue-800 rounded-lg transition text-yellow-400 font-semibold"><i class="fas fa-ticket-alt"></i> Ambil Nomor Surat</a>

            <% if (user.role === 'admin' || user.role === 'super_admin') { %>
                <a href="/surat-keluar" class="flex items-center gap-3 px-4 py-3 hover:bg-blue-800 rounded-lg transition"><i class="fas fa-paper-plane"></i> Buat Surat Keluar</a>
                <a href="/surat-masuk" class="flex items-center gap-3 px-4 py-3 hover:bg-blue-800 rounded-lg transition"><i class="fas fa-inbox"></i> Input Surat Masuk</a>
                <a href="/data-pengambilan-nomor" class="flex items-center gap-3 px-4 py-3 hover:bg-blue-800 rounded-lg transition text-yellow-300"><i class="fas fa-list"></i> Riwayat Ambil Nomor</a>

                <p class="px-4 text-xs font-semibold text-blue-300 uppercase tracking-wider mt-6 mb-2">Database Arsip</p>
                <p class="px-4 text-xs font-semibold text-blue-300 uppercase tracking-wider mt-6 mb-2">Master Data</p>
                <a href="/manajemen-klasifikasi" class="flex items-center gap-3 px-4 py-3 hover:bg-blue-800 rounded-lg transition"><i class="fas fa-tags"></i> Manajemen Klasifikasi</a>
                <a href="/manajemen-lokasi" class="flex items-center gap-3 px-4 py-3 hover:bg-blue-800 rounded-lg transition"><i class="fas fa-map-marker-alt"></i> Manajemen Lokasi</a>
                <a href="/data-surat-keluar" class="flex items-center gap-3 px-4 py-3 hover:bg-blue-800 rounded-lg transition"><i class="fas fa-folder-open"></i> Semua Surat Keluar</a>
                <a href="/data-surat-masuk" class="flex items-center gap-3 px-4 py-3 hover:bg-blue-800 rounded-lg transition"><i class="fas fa-archive"></i> Semua Surat Masuk</a>
            <% } %>

            <% if (user.role === 'super_admin') { %>
                <p class="px-4 text-xs font-semibold text-pink-300 uppercase tracking-wider mt-6 mb-2">Super Admin</p>
                <a href="/manajemen-pengguna" class="flex items-center gap-3 px-4 py-3 hover:bg-blue-800 rounded-lg transition text-pink-100"><i class="fas fa-users-cog"></i> Manajemen Pengguna</a>
            <% } %>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col overflow-y-auto">
        <header class="h-16 bg-white shadow-sm flex items-center justify-between px-8 border-b">
            <h2 class="text-xl font-semibold text-gray-800"><%= title %></h2>
            <div class="flex items-center gap-4">
                <% if (user.role === 'admin' || user.role === 'super_admin') { %>
                    <div class="relative inline-block text-left">
                        <button id="notifButton" class="relative p-2 text-gray-500 hover:text-blue-600 focus:outline-none transition">
                            <i class="fas fa-bell text-xl"></i>
                            <% if (pendingDrafts > 0) { %>
                                <span class="absolute top-0 right-0 inline-flex items-center justify-center px-1.5 py-0.5 text-xs font-bold text-white transform translate-x-1/4 -translate-y-1/4 bg-red-500 rounded-full"><%= pendingDrafts %></span>
                            <% } %>
                        </button>
                        <div id="notifDropdown" class="hidden absolute right-0 mt-2 w-72 bg-white rounded-md shadow-lg overflow-hidden z-50 border border-gray-200">
                            <div class="px-4 py-3 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
                                <span class="text-sm font-bold text-gray-700">Notifikasi Draft</span>
                            </div>
                            <% if (pendingDrafts > 0) { %>
                                <div class="p-3 bg-yellow-50 border-b border-yellow-100 text-xs text-yellow-800">Ada <b><%= pendingDrafts %></b> surat belum diupload PDF.</div>
                                <a href="/data-pengambilan-nomor" class="block text-center px-4 py-2.5 text-xs text-blue-600 hover:bg-gray-100 font-bold">Lihat Data &rarr;</a>
                            <% } else { %>
                                <div class="p-6 text-center text-xs text-gray-500">Tidak ada notifikasi baru.</div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
                <div class="flex flex-col text-right">
                    <span class="text-sm font-bold text-gray-800"><%= user.nama_lengkap %></span>
                    <span class="text-xs font-medium text-gray-500">
                        <%= user.role === 'super_admin' ? 'Super Admin' : (user.role === 'admin' ? 'Admin SIKD' : 'Staf SIKD') %>
                    </span>
                </div>
                <a href="/logout" class="ml-2 text-red-500 hover:text-red-700"><i class="fas fa-sign-out-alt fa-lg"></i></a>
            </div>
        </header>

        <div class="p-8">
            <!-- Filter Tahun Dinamis -->
            <div class="flex justify-between items-center mb-6 bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                <h3 class="text-lg font-bold text-gray-800"><i class="fas fa-chart-bar text-blue-600 mr-2"></i>Statistik Data Tahun <%= selectedYear %></h3>
                <form action="/" method="GET" class="flex items-center gap-2">
                    <label class="text-sm font-semibold text-gray-600">Pilih Tahun:</label>
                    <select name="tahun" onchange="this.form.submit()" class="border border-gray-300 rounded px-3 py-1.5 text-sm focus:ring-blue-500 bg-gray-50 font-bold text-blue-900">
                        <% availableYears.forEach(function(thn) { %>
                            <option value="<%= thn %>" <%= thn == selectedYear ? 'selected' : '' %>><%= thn %></option>
                        <% }); %>
                    </select>
                </form>
            </div>

            <!-- Wrapper Grid Statistik -->
            <div class="grid grid-cols-2 gap-6 mb-8">
                <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center">
                    <div class="w-14 h-14 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 text-2xl mr-4"><i class="fas fa-envelope"></i></div>
                    <div><p class="text-gray-500 text-sm font-semibold mb-1">Surat Keluar (<%= selectedYear %>)</p><h3 class="text-3xl font-bold text-gray-800"><%= totalSuratKeluar %></h3></div>
                </div>
                <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-center">
                    <div class="w-14 h-14 bg-green-100 rounded-lg flex items-center justify-center text-green-600 text-2xl mr-4"><i class="fas fa-inbox"></i></div>
                    <div><p class="text-gray-500 text-sm font-semibold mb-1">Surat Masuk (<%= selectedYear %>)</p><h3 class="text-3xl font-bold text-gray-800"><%= totalSuratMasuk %></h3></div>
                </div>
            </div>

            <!-- Tabel Riwayat Terbaru -->
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
                <!-- Surat Keluar -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-4 py-3 border-b bg-blue-50 text-blue-900 font-bold text-sm">Riwayat Keluar Terbaru (<%= selectedYear %>)</div>
                    <table class="w-full text-left text-xs text-gray-600">
                        <tbody class="divide-y divide-gray-100">
                            <% listSuratKeluar.forEach(function(surat) { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-4 py-2 font-medium"><%= surat.nomor_tergenerate %></td>
                                    <td class="px-4 py-2"><%= surat.tujuan %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <!-- Surat Masuk -->
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="px-4 py-3 border-b bg-green-50 text-green-900 font-bold text-sm">Riwayat Masuk Terbaru (<%= selectedYear %>)</div>
                    <table class="w-full text-left text-xs text-gray-600">
                        <tbody class="divide-y divide-gray-100">
                            <% listSuratMasuk.forEach(function(surat) { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-4 py-2 font-medium"><%= surat.nomor_surat %></td>
                                    <td class="px-4 py-2"><%= surat.pengirim %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const notifBtn = document.getElementById('notifButton'), notifDrop = document.getElementById('notifDropdown');
            if (notifBtn) {
                notifBtn.addEventListener('click', (e) => { e.stopPropagation(); notifDrop.classList.toggle('hidden'); });
                document.addEventListener('click', (e) => { if (!notifBtn.contains(e.target)) notifDrop.classList.add('hidden'); });
            }
        });
    </script>
</body>
</html>