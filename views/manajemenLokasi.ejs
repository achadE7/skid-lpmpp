<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 p-8">
    <div class="max-w-6xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-800"><i class="fas fa-map-marker-alt text-blue-600 mr-2"></i> Manajemen Lokasi Arsip</h2>
            <a href="/" class="bg-gray-500 text-white px-4 py-2 rounded text-sm font-bold shadow hover:bg-gray-600">Kembali</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Tambah Ruangan -->
            <div class="bg-white p-6 rounded-xl shadow-sm border-t-4 border-indigo-500">
                <h3 class="font-bold text-gray-800 mb-4">1. Tambah Ruangan</h3>
                <form action="/api/tambah-ruangan" method="POST" class="flex gap-2">
                    <input type="text" name="nama_ruangan" required placeholder="Cth: Ruang Arsip A" class="border px-3 py-2 rounded text-sm flex-1">
                    <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded font-bold text-sm">+</button>
                </form>
            </div>

            <!-- Tambah Kabinet -->
            <div class="bg-white p-6 rounded-xl shadow-sm border-t-4 border-blue-500">
                <h3 class="font-bold text-gray-800 mb-4">2. Tambah Kabinet</h3>
                <form action="/api/tambah-kabinet" method="POST" class="flex gap-2">
                    <select name="id_ruangan" required class="border px-2 py-2 rounded text-sm w-1/3">
                        <option value="">Pilih Ruangan...</option>
                        <% ruangan.forEach(r => { %> <option value="<%= r.id %>"><%= r.nama_ruangan %></option> <% }) %>
                    </select>
                    <input type="text" name="nama_kabinet" required placeholder="Cth: Lemari 01" class="border px-3 py-2 rounded text-sm flex-1">
                    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded font-bold text-sm">+</button>
                </form>
            </div>

            <!-- Tambah Laci -->
            <div class="bg-white p-6 rounded-xl shadow-sm border-t-4 border-teal-500">
                <h3 class="font-bold text-gray-800 mb-4">3. Tambah Laci</h3>
                <form action="/api/tambah-laci" method="POST" class="flex gap-2">
                    <select name="id_kabinet" required class="border px-2 py-2 rounded text-sm w-1/2">
                        <option value="">Pilih Kabinet...</option>
                        <% kabinet.forEach(k => { %> <option value="<%= k.id %>"><%= k.nama_ruangan %> - <%= k.nama_kabinet %></option> <% }) %>
                    </select>
                    <input type="text" name="nama_laci" required placeholder="Cth: Laci Bawah" class="border px-3 py-2 rounded text-sm flex-1">
                    <button type="submit" class="bg-teal-600 text-white px-4 py-2 rounded font-bold text-sm">+</button>
                </form>
            </div>

            <!-- Tambah Ordner -->
            <div class="bg-white p-6 rounded-xl shadow-sm border-t-4 border-yellow-500">
                <h3 class="font-bold text-gray-800 mb-4">4. Tambah Ordner (Map)</h3>
                <form action="/api/tambah-ordner" method="POST" class="flex gap-2">
                    <select name="id_laci" required class="border px-2 py-2 rounded text-sm w-1/2">
                        <option value="">Pilih Laci...</option>
                        <% laci.forEach(l => { %> <option value="<%= l.id %>"><%= l.nama_kabinet %> - <%= l.nama_laci %></option> <% }) %>
                    </select>
                    <input type="text" name="nama_ordner" required placeholder="Cth: Ordner Surat Keputusan" class="border px-3 py-2 rounded text-sm flex-1">
                    <button type="submit" class="bg-yellow-500 text-white px-4 py-2 rounded font-bold text-sm">+</button>
                </form>
            </div>
            
        </div>
    </div>
</body>
</html>