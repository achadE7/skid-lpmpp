<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Manajemen Pengguna SIKD</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 p-8">
    <div class="max-w-4xl mx-auto bg-white p-6 rounded-xl shadow-sm border-t-4 border-pink-600">
        <div class="flex justify-between items-center mb-6 border-b pb-4">
            <h2 class="text-2xl font-bold text-gray-800"><i class="fas fa-users-cog text-pink-600 mr-2"></i> Manajemen Pengguna</h2>
            <a href="/" class="bg-gray-500 text-white px-4 py-2 rounded text-sm font-bold shadow hover:bg-gray-600">Kembali</a>
        </div>

        <table class="w-full text-left text-sm text-gray-600">
            <thead class="bg-pink-50 text-pink-900">
                <tr>
                    <th class="px-4 py-3">Nama Lengkap</th>
                    <th class="px-4 py-3">Role</th>
                    <th class="px-4 py-3">Username Aktif</th>
                    <th class="px-4 py-3 text-center">Aksi (Ubah Kredensial)</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% users.forEach(function(u) { %>
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 font-bold"><%= u.nama_lengkap %></td>
                        <td class="px-4 py-3"><%= u.role.replace('_', ' ').toUpperCase() %></td>
                        <td class="px-4 py-3 font-mono text-blue-600"><%= u.username %></td>
                        <td class="px-4 py-3 text-center">
                            <!-- Form Edit Username/Password Instan -->
                            <form action="/api/edit-user/<%= u.id %>" method="POST" class="flex items-center justify-center gap-2">
                                <input type="text" name="username" value="<%= u.username %>" class="border rounded px-2 py-1 w-24 text-xs" required placeholder="Username">
                                <input type="password" name="password" class="border rounded px-2 py-1 w-24 text-xs bg-gray-100 focus:bg-white" placeholder="Pass Baru (Opsional)">
                                <button type="submit" class="bg-pink-600 hover:bg-pink-700 text-white px-3 py-1 rounded text-xs font-bold transition">Simpan</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
        <p class="text-xs text-gray-400 mt-4">*Kosongkan kolom password jika tidak ingin mengganti password lama pengguna.</p>
    </div>
</body>
</html>